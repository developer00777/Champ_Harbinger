    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/run-worker.ts",
    "worker:dev": "tsx watch scripts/run-worker.ts",
    "prepare": "husky",
    "enrich:sync": "tsx scripts/enrich-sync.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yaml,yml}": [
      "prettier --write"
    ]
