  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:pages": "playwright test --project=pages",
    "test:e2e:kb": "playwright test --project=knowledge-base",
    "test:e2e:signals": "playwright test --project=signals",
