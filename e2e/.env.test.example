# Copy to e2e/.env.test for local E2E testing.
# Values here are merged with .env.local (which takes precedence).

# Required — must be Clerk *test* instance keys (pk_test_ / sk_test_)
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional — get from Settings -> Keys after running the app locally.
# Without this, all api.v1.test.ts tests are skipped automatically.
CHAMPIQ_TEST_API_KEY=chh_...
