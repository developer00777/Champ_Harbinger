# ============================================================================
# ChampHarbinger environment variables
# ============================================================================
# Copy this file to .env.local (for `pnpm dev`) or .env (for Docker) and
# fill in the values. Keys are grouped by required / optional. You only need
# the "required" block to get a dev server running.
#
# Champions Group product. Empowering Innovation. Building Resilience.
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED: Database (Postgres)
# ----------------------------------------------------------------------------
# ChampHarbinger runs on vanilla Postgres via Drizzle ORM. For local dev,
# `docker compose up -d postgres` provisions one with the URL below. For
# staging/production, point this at any Postgres host (Railway, Neon, RDS,
# self-managed). Connection-string is the only thing that changes.
DATABASE_URL=postgres://harbinger:harbinger@localhost:5432/champ_harbinger


# ----------------------------------------------------------------------------
# REQUIRED: Clerk (auth)
# ----------------------------------------------------------------------------
# Sign up at https://clerk.com and create an application. Copy the publishable
# and secret keys from API Keys.
#
# In dev, all three can be left blank: Next.js Clerk runs in Keyless mode and
# auto-generates a temporary application on first load. Free tier covers 10k MAU.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_DOMAIN=

# Custom Clerk URLs — keep these defaults so /login and /signup match the
# routes shipped in src/app/(auth). Override only if you move the routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard


# ----------------------------------------------------------------------------
# REQUIRED: OpenRouter (LLM access)
# ----------------------------------------------------------------------------
# ChampHarbinger uses OpenRouter so any model on any provider (Anthropic,
# OpenAI, Google, Meta, etc.) is one config change away. Sign up at
# https://openrouter.ai and create an API key. Starts with `sk-or-v1-`.
OPENROUTER_API_KEY=

# Default model used by chat, enrichment, drafts, etc. Override per-call only
# when a feature needs a specific model (cheap classifier vs. heavy drafter).
# Examples:
#   anthropic/claude-sonnet-4.6
#   openai/gpt-4o-mini
#   google/gemini-2.5-pro
HARBINGER_DEFAULT_MODEL=anthropic/claude-sonnet-4.6


# ----------------------------------------------------------------------------
# OPTIONAL: Ollama — self-hosted local LLM for classification tasks
# ----------------------------------------------------------------------------
# When OLLAMA_BASE_URL is set, classification workloads (criteria translation,
# signal verification) route through a local Ollama instance instead of
# OpenRouter — slashing per-call cost to zero. Leave OLLAMA_BASE_URL empty
# to use the OpenRouter classification model instead (the default).
#
# Recommended model: llama3.1:8b (works for criteria translation and verification)
# Setup: docker compose up -d ollama && docker compose exec ollama ollama pull llama3.1:8b
OLLAMA_BASE_URL=
OLLAMA_CLASSIFICATION_MODEL=llama3.1:8b


# ----------------------------------------------------------------------------
# Self-hosted scraping + discovery (free — no external SaaS)
# ----------------------------------------------------------------------------
# `docker compose up` starts these. Without them, web extraction falls back to
# direct fetch + Cheerio only and JS-dependent scrapers degrade gracefully.
#
# Obscura — headless browser via HTTP gateway (services/obscura-gateway).
OBSCURA_GATEWAY_URL=http://localhost:9223
# Trafilatura — article-extraction microservice (static tier).
TRAFILATURA_BASE_URL=http://localhost:8001
# SearXNG — metasearch backend for public-web prospect discovery.
SEARXNG_URL=http://localhost:8090

# Bright Data — residential unblocking for LinkedIn ONLY. LinkedIn auth-walls
# unauthenticated fetches; Web Unlocker routes through residential IPs, gets past
# the wall, and returns the rendered HTML, which we parse in-house (only the
# public profile URL leaves — nothing is retained by Bright Data). When unset,
# LinkedIn retrieval falls back to the self-hosted Obscura browser above.
# Create a Web Unlocker zone in the Bright Data dashboard and set its name here.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# Optional request timeout in seconds (default 30).
BRIGHTDATA_TIMEOUT_SEC=30
# Web Unlocker occasionally returns an empty 200 on the first (cold) request for
# a hard target like LinkedIn, then succeeds on retry. Total attempts on empty
# (default 3) and delay between them in ms (default 1500).
BRIGHTDATA_MAX_ATTEMPTS=3
BRIGHTDATA_RETRY_DELAY_MS=1500


# ----------------------------------------------------------------------------
# OPTIONAL: Crawl4AI — self-hosted Python crawl service
# ----------------------------------------------------------------------------
# Crawl4AI — self-hosted Python crawl service (see services/crawl4ai/README.md)
# Replaces paid browser scraping for bulk signal extraction. Start with
# `docker compose up -d crawl4ai`. Leave blank to disable; the bulk crawl
# chat tools then return a graceful "not configured" message.
CRAWL4AI_BASE_URL=http://localhost:8000


# ----------------------------------------------------------------------------
# OPTIONAL: ChampMail (outbound email + delivery tracking)
# ----------------------------------------------------------------------------
# Self-hosted ChampMail. Set BASE_URL + API_KEY to enable real sending; without
# them the stub keeps sending disabled.
CHAMPMAIL_BASE_URL=            # e.g. https://mail.championsmail.com
CHAMPMAIL_API_KEY=            # sent as X-API-Key (JWT is optional on /send)
CHAMPMAIL_DOMAIN_ID=          # optional default sending domain id
# Shared secret ChampMail (or an n8n bridge) sends as X-Webhook-Secret on the
# inbound delivery webhook POST /api/email/track. Blank = no check (dev).
CHAMPMAIL_WEBHOOK_SECRET=
# Force a provider: 'champmail' | 'stub' (default: champmail when configured).
EMAIL_PROVIDER=


# ----------------------------------------------------------------------------
# OPTIONAL: InboxKit — email infrastructure (cold-outreach domains + mailboxes)
# ----------------------------------------------------------------------------
# Sign up at https://inboxkit.com. Set INBOXKIT_API_KEY to enable domain
# search/registration and mailbox provisioning from Settings; without it,
# infra endpoints return 501 and only user-connected mailboxes work.
INBOXKIT_API_KEY=              # Bearer token, from the InboxKit dashboard
INBOXKIT_WORKSPACE_ID=         # optional, sent as X-Workspace-Id
INBOXKIT_WEBHOOK_SECRET=       # shared secret InboxKit sends as X-Webhook-Secret on status_change webhooks (blank = no check, dev only)


# ----------------------------------------------------------------------------
# Background jobs + scheduling (self-hosted, Postgres-backed via pg-boss)
# ----------------------------------------------------------------------------
# No external service: the job queue runs on the DATABASE_URL above. Start the
# worker with `pnpm worker` (dev: `pnpm worker:dev`); `docker compose up` runs
# it as the `worker` service. Without a running worker, signals still run
# manually from the UI — only the scheduled cadence pauses.
#
# Shared secret the worker sends (X-Worker-Secret) so the internal job routes
# (/api/tracking/run, /api/tracking/dispatch) reject untrusted callers. Leave
# blank in local dev to skip the check. Generate: openssl rand -hex 16
WORKER_SECRET=
# Cron schedules (standard 5-field cron).
TRACKING_DISPATCH_CRON=*/5 * * * *
OUTREACH_FOLLOWUPS_CRON=*/15 * * * *
# URL the worker uses to reach the app. In docker compose: http://app:3000.
WORKER_TARGET_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# OPTIONAL: data providers (enrichment + signals)
# ----------------------------------------------------------------------------
# Google Places (https://developers.google.com/maps/documentation/places/web-service).
GOOGLE_API_KEY=

# GitHub — required for GitHub-based signals (commit activity, release cadence).
# Generate at https://github.com/settings/tokens (fine-grained recommended,
# read-only public_repo is usually enough).
GITHUB_TOKEN=

# LakeB2B — Champions Group's internal data provider (120M+ verified contacts).
# Set LAKEB2B_MOCK=true to use the inline mock dataset (no API key required).
# For the real API, set LAKEB2B_API_URL to the base URL and LAKEB2B_API_KEY.
# Users can also store their own key via Settings → Keys (BYOK).
# LakeB2B is the pinned PRIMARY source in the enrichment waterfall: it supplies
# the identity/contact/firmographic backbone that the owned LinkedIn/web scrape
# then augments. With LAKEB2B_MOCK=true the adapter runs (free) against the mock
# so the primary path can be validated end-to-end without a live key.
LAKEB2B_MOCK=true
LAKEB2B_API_URL=
LAKEB2B_API_KEY=
# USD charged per real (non-mock) LakeB2B lookup, counted against the job budget.
COST_LAKEB2B=0.08

# ── Paid enrichment data APIs (waterfall escalation tiers) ──────────────────
# These run ONLY for required fields still missing after the owned tiers +
# LakeB2B, in provider-priority order, and each no-ops until its key is set
# (env here, or per-user via Settings → Keys). Their per-call USD cost is logged
# to api_usage, so it counts against each user's weekly credit limit (set per
# team/member in the /admin console). Configure escalation order + coverage via
# PROVIDER_PRIORITY (see src/lib/enrichment/config.ts).
#
# Apollo — https://developer.apollo.io/keys
APOLLO_API_KEY=
COST_APOLLO=0.2
# People Data Labs — https://dashboard.peopledatalabs.com/api-keys
PDL_API_KEY=
COST_PDL=0.1
# Minimum PDL match confidence to accept a record (1-10, default 6).
PDL_MIN_LIKELIHOOD=6

# NOTE: the searchWeb / searchNews chat tools reuse SEARXNG_URL (set above).
# No separate SEARXNG_BASE_URL is needed — one SearXNG instance serves both
# public-web discovery and the chat search tools.

# ChampOracle (ChampIQ backend) — the X-ChampOracle-API-Key header value
# sent on outbound prospect-push requests. Per-user keys can also be stored
# via Settings → Keys (BYOK) under "champoracle_api_key".
CHAMPORACLE_OUTBOUND_API_KEY=


# ----------------------------------------------------------------------------
# OPTIONAL: Sentry (error tracking)
# ----------------------------------------------------------------------------
# Sign up at https://sentry.io. Both DSNs can be blank in dev — Sentry init
# no-ops without them. For production, set BOTH so client-side and server-side
# errors are captured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# For source-map uploads at build time (production only).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ----------------------------------------------------------------------------
# OPTIONAL: PostHog (product analytics + session replay)
# ----------------------------------------------------------------------------
# Sign up at https://posthog.com. Each self-hosted ChampHarbinger instance
# points at its OWN PostHog project. Leave blank to disable analytics
# entirely (client init and server captures both no-op).
#
# Token: Project Settings → Project API Key (starts with `phc_`).
# Host:  https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=


# ----------------------------------------------------------------------------
# OPTIONAL: deployment URL
# ----------------------------------------------------------------------------
# The public URL your instance is reachable at. Used for webhook callbacks.
# Defaults to http://localhost:3000 locally. On Railway, set this to the
# `*.up.railway.app` (or custom) domain after first deploy.
NEXT_PUBLIC_HARBINGER_APP_URL=http://localhost:3000

# App environment label (development | staging | production). Surfaced into
# Sentry release tags and any environment-aware UI badges.
HARBINGER_NODE_ENV=development


# ----------------------------------------------------------------------------
# OPTIONAL: Grafana (observability)
# ----------------------------------------------------------------------------
# The app exposes Prometheus metrics at /api/metrics. `docker compose up`
# starts a self-hosted Prometheus (see prometheus/prometheus.yml) that scrapes
# them; add it as a data source in your Grafana. To auto-provision the
# dashboard, set these and run: pnpm tsx scripts/provision-grafana.ts
# (token is read from the env — never commit it).
GRAFANA_URL=
GRAFANA_TOKEN=


# ----------------------------------------------------------------------------
# App: BYOK key encryption
# ----------------------------------------------------------------------------
# Secret used to AES-256-GCM-encrypt user-supplied API keys at rest.
# Must be at least 32 characters. Generate with: openssl rand -hex 16
HARBINGER_SECRET=


# ----------------------------------------------------------------------------
# Multi-tenant / budgets / fairness
# ----------------------------------------------------------------------------
# When ChampHarbinger runs as a shared, invite-only multi-tenant instance (the
# Railway production deploy — see docs/DEPLOY-RAILWAY.md) these knobs protect a
# single shared OpenRouter key from being exhausted or rate-limited by any one
# user. Every value below has a safe in-code default, so leaving an entry blank
# falls back to the default shown in its comment — none are strictly required
# to boot, but you SHOULD set SUPER_ADMIN_USER_IDS and GLOBAL_WEEKLY_BUDGET_USD
# in production.

# Pipe-separated Clerk user ids allowed into the /admin super-admin console
# (team/budget management, pause switches). Commas and whitespace also work as
# separators. Find your id in the Clerk dashboard → Users, or via the /admin
# 403 page. Blank = no one can reach /admin (locks you out in production).
# Example: SUPER_ADMIN_USER_IDS=user_2abcDEF...|user_3ghiJKL...
SUPER_ADMIN_USER_IDS=

# Hard weekly spend cap (USD) for the WHOLE instance. When trailing-week spend
# reaches this, paid LLM work is blocked at coarse entry points (heavy job
# intake + chat) until the weekly window rolls over. This is the in-app cap;
# ALSO set a key-level credit limit in the OpenRouter dashboard as a hard
# backstop (see docs/DEPLOY-RAILWAY.md). Blank / 0 / non-numeric = unlimited.
# Example: GLOBAL_WEEKLY_BUDGET_USD=50
GLOBAL_WEEKLY_BUDGET_USD=

# Max concurrent in-flight LLM calls per app process. A FIFO semaphore queues
# excess calls so the shared OpenRouter key is never hammered into 429s.
# (default: 12)
LLM_MAX_CONCURRENCY=12

# Fair-share scheduling for the background worker's pg-boss job intake: at most
# this many heavy jobs per user run at once. (default: 3)
FAIR_PER_USER_MAX=3

# ...bounded in total across all users by this global ceiling. (default: 8)
FAIR_GLOBAL_MAX=8

# pg-boss fetch batch size — how many queued jobs the worker pulls per poll.
# (default: 20)
BOSS_FETCH_BATCH=20

# TTL (ms) of the per-process cached spend tally used by the budget guard, so
# budget checks don't hit the DB on every request. (default: 45000)
BUDGET_CACHE_TTL_MS=45000

# Max enrichment requests processed in parallel within a single waterfall
# enrichment set. (default: 4)
ENRICH_SET_CONCURRENCY=4

